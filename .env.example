# Canonical production origin; mutations fail closed without this in production.
NEXT_PUBLIC_SITE_URL=https://taoshiflexstudio.me
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Transitional legacy fallback; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_CURATOR_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
STUDIO_ALERT_SMTP_HOST=
STUDIO_ALERT_SMTP_PORT=465
STUDIO_ALERT_SMTP_SECURE=true
STUDIO_ALERT_SMTP_USER=
STUDIO_ALERT_SMTP_PASSWORD=
STUDIO_ALERT_SMTP_FROM=
# NETLIFY is provided by Netlify; do not enable it on an untrusted proxy.
